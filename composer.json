{
    "name": "shubo/module-qshpr",
    "description": "Quickshipper delivery (Wolt, Glovo, OnWay and other Georgian couriers) shipping carrier for Magento 2",
    "type": "magento2-module",
    "license": "Apache-2.0",
    "keywords": [
        "magento2",
        "shipping",
        "quickshipper",
        "courier",
        "georgia"
    ],
    "homepage": "https://github.com/nshubitidze/shubo-qshpr",
    "authors": [
        {
            "name": "Nikoloz Shubitidze",
            "homepage": "https://github.com/nshubitidze"
        }
    ],
    "support": {
        "issues": "https://github.com/nshubitidze/shubo-qshpr/issues",
        "source": "https://github.com/nshubitidze/shubo-qshpr"
    },
    "require": {
        "php": "~8.3.0||~8.4.0||~8.5.0",
        "laminas/laminas-http": "^2.23",
        "magento/framework": "^103.0",
        "magento/module-backend": "^102.0",
        "magento/module-catalog": "^104.0",
        "magento/module-checkout": "^100.4",
        "magento/module-config": "^101.2",
        "magento/module-cron": "^100.4",
        "magento/module-csp": "^100.4",
        "magento/module-directory": "^100.4",
        "magento/module-payment": "^100.4",
        "magento/module-quote": "^101.2",
        "magento/module-sales": "^103.0",
        "magento/module-shipping": "^100.4",
        "magento/module-store": "^101.1"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Shubo\\Qshpr\\": ""
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://mirror.mage-os.org/"
        }
    ],
    "config": {
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": true,
            "magento/magento-composer-installer": true,
            "laminas/laminas-dependency-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}

<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Api/etc/extension_attributes.xsd">
    <!-- The courier's logo for a Quickshipper shipping method at checkout, and
         whether its courier takes a delivery time. -->
    <extension_attributes for="Magento\Quote\Api\Data\ShippingMethodInterface">
        <attribute code="shubo_qshpr_logo_url" type="string"/>
        <attribute code="shubo_qshpr_takes_time" type="boolean"/>
    </extension_attributes>

    <!-- The delivery time the customer chose at checkout (slot start, UTC ISO 8601). -->
    <extension_attributes for="Magento\Checkout\Api\Data\ShippingInformationInterface">
        <attribute code="shubo_qshpr_delivery_time" type="string"/>
    </extension_attributes>
</config>

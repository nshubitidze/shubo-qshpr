<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Delivery times the customer can choose at checkout. -->
    <type name="Magento\Checkout\Model\CompositeConfigProvider">
        <arguments>
            <argument name="configProviders" xsi:type="array">
                <item name="shubo_qshpr_delivery_time"
                      xsi:type="object">Shubo\Qshpr\Model\Ui\DeliveryTimeConfigProvider</item>
            </argument>
        </arguments>
    </type>
    <!-- The "Delivery time" list under the delivery options. -->
    <type name="Magento\Checkout\Block\Onepage">
        <arguments>
            <argument name="layoutProcessors" xsi:type="array">
                <item name="shubo_qshpr_delivery_time"
                      xsi:type="object">Shubo\Qshpr\Model\Checkout\DeliveryTimeLayout</item>
            </argument>
        </arguments>
    </type>
</config>

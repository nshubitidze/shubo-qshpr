<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Global: orders are placed in the frontend and webapi_rest areas. -->
    <event name="sales_model_service_quote_submit_success">
        <observer name="shubo_qshpr_record_delivery" instance="Shubo\Qshpr\Observer\RecordDelivery"/>
    </event>
    <event name="checkout_submit_all_after">
        <observer name="shubo_qshpr_record_multishipping_deliveries"
                  instance="Shubo\Qshpr\Observer\RecordMultishippingDeliveries"/>
    </event>
    <event name="sales_order_shipment_save_after">
        <observer name="shubo_qshpr_link_shipment" instance="Shubo\Qshpr\Observer\LinkShipment"/>
    </event>
    <event name="sales_order_invoice_pay">
        <observer name="shubo_qshpr_mark_paid_for_dispatch" instance="Shubo\Qshpr\Observer\MarkPaidForDispatch"/>
    </event>
    <event name="sales_order_creditmemo_save_commit_after">
        <observer name="shubo_qshpr_cancel_on_refund" instance="Shubo\Qshpr\Observer\CancelOnRefund"/>
    </event>
    <event name="sales_order_shipment_save_commit_after">
        <observer name="shubo_qshpr_release_delivery_lock" instance="Shubo\Qshpr\Observer\ReleaseDeliveryLock"/>
    </event>
    <!-- Checkout lists payment methods in the frontend and webapi_rest areas. -->
    <event name="payment_method_is_active">
        <observer name="shubo_qshpr_hide_cash_on_delivery" instance="Shubo\Qshpr\Observer\HideCashOnDelivery"/>
    </event>
</config>
